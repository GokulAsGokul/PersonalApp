<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".AddInvestmentDetails.AddInvestmentDetailsActivity">

        <TextView
            android:id="@+id/investDecHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/add_investment_details"
            android:textColor="@color/background"
            android:textSize="25sp"
            android:textStyle="bold|italic"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/investDecNameLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="32dp"
            android:hint="@string/enter_company_name"
            android:textColorHint="@color/background"
            android:theme="@style/ThemeOverlay.AppTheme.TextInputEditText.Outlined"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/grey"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="2dp"
            app:endIconMode="clear_text"
            app:endIconTint="@color/background"
            app:errorTextColor="@color/red"
            app:hintTextColor="@color/background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/investDecHeading"
            app:startIconDrawable="@drawable/ic_name"
            app:startIconTint="@color/background">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/investDecName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textCapWords"
                android:textColor="@color/background"
                android:textCursorDrawable="@drawable/color_cursor"
                android:textSize="20sp"
                android:textStyle="bold|italic" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/investDecAmountLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/enter_invested_amount"
            android:textColorHint="@color/background"
            android:theme="@style/ThemeOverlay.AppTheme.TextInputEditText.Outlined"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/grey"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="2dp"
            app:endIconMode="clear_text"
            app:endIconTint="@color/background"
            app:errorTextColor="@color/red"
            app:hintTextColor="@color/background"
            app:layout_constraintEnd_toEndOf="@+id/investDecNameLayout"
            app:layout_constraintStart_toStartOf="@+id/investDecNameLayout"
            app:layout_constraintTop_toBottomOf="@+id/investDecNameLayout"
            app:startIconDrawable="@drawable/ic_rupee"
            app:startIconTint="@color/background">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/investDecAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="numberDecimal"
                android:textColor="@color/background"
                android:textCursorDrawable="@drawable/color_cursor"
                android:textSize="20sp"
                android:textStyle="bold|italic" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/investDecFolioLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/enter_folio_number"
            android:textColorHint="@color/background"
            android:theme="@style/ThemeOverlay.AppTheme.TextInputEditText.Outlined"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/grey"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="2dp"
            app:endIconTint="@color/background"
            app:errorTextColor="@color/red"
            app:hintTextColor="@color/background"
            app:layout_constraintEnd_toEndOf="@+id/investDecAmountLayout"
            app:layout_constraintStart_toStartOf="@+id/investDecAmountLayout"
            app:layout_constraintTop_toBottomOf="@+id/investDecAmountLayout"
            app:startIconDrawable="@drawable/ic_view_balance"
            app:startIconTint="@color/background">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/investDecFolio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="number"
                android:textColor="@color/background"
                android:textCursorDrawable="@drawable/color_cursor"
                android:textSize="20sp"
                android:textStyle="bold|italic" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/investDecTermLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/enter_term_length"
            android:textColorHint="@color/background"
            android:theme="@style/ThemeOverlay.AppTheme.TextInputEditText.Outlined"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/grey"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="2dp"
            app:endIconMode="clear_text"
            app:endIconTint="@color/background"
            app:errorTextColor="@color/red"
            app:hintTextColor="@color/background"
            app:layout_constraintEnd_toEndOf="@+id/investDecFolioLayout"
            app:layout_constraintStart_toStartOf="@+id/investDecFolioLayout"
            app:layout_constraintTop_toBottomOf="@+id/investDecFolioLayout"
            app:startIconDrawable="@drawable/ic_type"
            app:startIconTint="@color/background">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/investDecTerm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:textColor="@color/background"
                android:textCursorDrawable="@drawable/color_cursor"
                android:textSize="20sp"
                android:textStyle="bold|italic" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/investDecSourceLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/select_source"
            android:textColorHint="@color/background"
            android:theme="@style/ThemeOverlay.AppTheme.TextInputEditText.Outlined"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/grey"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="2dp"
            app:endIconTint="@color/background"
            app:errorTextColor="@color/red"
            app:hintTextColor="@color/background"
            app:layout_constraintEnd_toEndOf="@+id/investDecTermLayout"
            app:layout_constraintStart_toStartOf="@+id/investDecTermLayout"
            app:layout_constraintTop_toBottomOf="@+id/investDecTermLayout"
            app:startIconDrawable="@drawable/ic_view_balance"
            app:startIconTint="@color/background">

            <AutoCompleteTextView
                android:id="@+id/investDecSource"
                android:layout_width="match_parent"
                android:layout_height="60sp"
                android:inputType="none"
                android:textColor="@color/background"
                android:textSize="20sp"
                android:textStyle="bold|italic"
                tools:ignore="LabelFor" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/investDecTranDateLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/transaction_date"
            android:textColorHint="@color/background"
            android:theme="@style/ThemeOverlay.AppTheme.TextInputEditText.Outlined"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/grey"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="2dp"
            app:errorTextColor="@color/red"
            app:layout_constraintEnd_toEndOf="@+id/investDecSourceLayout"
            app:layout_constraintStart_toStartOf="@+id/investDecSourceLayout"
            app:layout_constraintTop_toBottomOf="@+id/investDecSourceLayout"
            app:startIconDrawable="@drawable/ic_date"
            app:startIconTint="@color/background">

            <AutoCompleteTextView
                android:id="@+id/investDecTranDate"
                android:layout_width="match_parent"
                android:layout_height="60sp"
                android:inputType="none"
                android:textColor="@color/background"
                android:textCursorDrawable="@drawable/color_cursor"
                android:textSize="20sp"
                android:textStyle="bold|italic"
                tools:ignore="LabelFor" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/investDecRemarksLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/remarks"
            android:textColorHint="@color/background"
            android:theme="@style/ThemeOverlay.AppTheme.TextInputEditText.Outlined"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/grey"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="2dp"
            app:counterEnabled="true"
            app:counterMaxLength="20"
            app:counterTextColor="@color/background"
            app:endIconMode="clear_text"
            app:endIconTint="@color/background"
            app:errorTextColor="@color/red"
            app:hintTextColor="@color/background"
            app:layout_constraintEnd_toEndOf="@+id/investDecTranDateLayout"
            app:layout_constraintStart_toStartOf="@+id/investDecTranDateLayout"
            app:layout_constraintTop_toBottomOf="@+id/investDecTranDateLayout"
            app:startIconDrawable="@drawable/ic_remarks"
            app:startIconTint="@color/background">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/investDecRemarks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSend"
                android:inputType="textCapWords"
                android:maxLength="20"
                android:text="@string/mention_if_any"
                android:textColor="@color/background"
                android:textCursorDrawable="@drawable/color_cursor"
                android:textSize="20sp"
                android:textStyle="bold|italic" />
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/investDecSubmit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_background"
            android:text="  Submit  "
            android:textColor="@color/white"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/investDecRemarksLayout"
            tools:ignore="HardcodedText" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/investDecSubmit" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>