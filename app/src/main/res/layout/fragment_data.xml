<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AdminActivity.DataFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/dataHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/download_amp_export_data"
            android:textColor="@color/background"
            android:textSize="25sp"
            android:textStyle="bold|italic"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/dataTableLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="50dp"
            android:layout_marginEnd="32dp"
            android:hint="@string/select_data_table"
            android:textColorHint="@color/background"
            android:theme="@style/ThemeOverlay.AppTheme.TextInputEditText.Outlined"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/grey"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="2dp"
            app:endIconTint="@color/background"
            app:errorTextColor="@color/red"
            app:hintTextColor="@color/background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dataHeading"
            app:startIconDrawable="@drawable/ic_category"
            app:startIconTint="@color/background">

            <AutoCompleteTextView
                android:id="@+id/dataTable"
                android:layout_width="match_parent"
                android:layout_height="60sp"
                android:inputType="none"
                android:textColor="@color/background"
                android:textSize="20sp"
                android:textStyle="bold|italic"
                tools:ignore="LabelFor" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/dataTypeLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/select_file_type"
            android:textColorHint="@color/background"
            android:theme="@style/ThemeOverlay.AppTheme.TextInputEditText.Outlined"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/grey"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="2dp"
            app:endIconTint="@color/background"
            app:errorTextColor="@color/red"
            app:hintTextColor="@color/background"
            app:layout_constraintEnd_toEndOf="@+id/dataTableLayout"
            app:layout_constraintStart_toStartOf="@+id/dataTableLayout"
            app:layout_constraintTop_toBottomOf="@+id/dataTableLayout"
            app:startIconDrawable="@drawable/ic_type"
            app:startIconTint="@color/background">

            <AutoCompleteTextView
                android:id="@+id/dataType"
                android:layout_width="match_parent"
                android:layout_height="60sp"
                android:inputType="none"
                android:textColor="@color/background"
                android:textSize="20sp"
                android:textStyle="bold|italic"
                tools:ignore="LabelFor" />
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/dataDownloadButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="@drawable/button_background"
            android:text="  Download  "
            android:textColor="@color/white"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dataTypeLayout"
            tools:ignore="HardcodedText" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/dataUploadNameLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="80dp"
            android:hint="@string/select_file_name"
            android:textColorHint="@color/background"
            android:theme="@style/ThemeOverlay.AppTheme.TextInputEditText.Outlined"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/grey"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="2dp"
            app:endIconTint="@color/background"
            app:errorTextColor="@color/red"
            app:hintTextColor="@color/background"
            app:layout_constraintEnd_toEndOf="@+id/dataTypeLayout"
            app:layout_constraintStart_toStartOf="@+id/dataTypeLayout"
            app:layout_constraintTop_toBottomOf="@+id/dataDownloadButton"
            app:startIconDrawable="@drawable/ic_type"
            app:startIconTint="@color/background">

            <AutoCompleteTextView
                android:id="@+id/dataUploadName"
                android:layout_width="match_parent"
                android:layout_height="60sp"
                android:inputType="none"
                android:textColor="@color/background"
                android:textSize="20sp"
                android:textStyle="bold|italic"
                tools:ignore="LabelFor" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/dataUploadFileLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/select_a_file_to_upload"
            android:textColorHint="@color/background"
            android:theme="@style/ThemeOverlay.AppTheme.TextInputEditText.Outlined"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/grey"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="2dp"
            app:endIconTint="@color/background"
            app:errorTextColor="@color/red"
            app:hintTextColor="@color/background"
            app:layout_constraintEnd_toEndOf="@+id/dataUploadNameLayout"
            app:layout_constraintStart_toStartOf="@+id/dataUploadNameLayout"
            app:layout_constraintTop_toBottomOf="@+id/dataUploadNameLayout"
            app:startIconDrawable="@drawable/ic_type"
            app:startIconTint="@color/background">

            <AutoCompleteTextView
                android:id="@+id/dataUploadFile"
                android:layout_width="match_parent"
                android:layout_height="60sp"
                android:inputType="none"
                android:textColor="@color/background"
                android:textSize="20sp"
                android:textStyle="bold|italic"
                tools:ignore="LabelFor" />
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/dataUploadButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="@drawable/button_background"
            android:text="  Upload  "
            android:textColor="@color/white"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dataUploadFileLayout"
            tools:ignore="HardcodedText" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>