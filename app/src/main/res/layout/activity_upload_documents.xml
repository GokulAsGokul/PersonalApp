<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".UploadDocuments.UploadDocumentsActivity">

        <TextView
            android:id="@+id/docUploadHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:text="@string/upload_documents"
            android:textColor="@color/background"
            android:textSize="30sp"
            android:textStyle="bold|italic"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/docUploadNameLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="100dp"
            android:layout_marginEnd="32dp"
            android:hint="@string/document_name"
            android:textColorHint="@color/background"
            android:theme="@style/ThemeOverlay.AppTheme.TextInputEditText.Outlined"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/grey"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="2dp"
            app:counterEnabled="true"
            app:counterMaxLength="25"
            app:counterTextColor="@color/background"
            app:endIconMode="clear_text"
            app:endIconTint="@color/background"
            app:errorTextColor="@color/red"
            app:hintTextColor="@color/background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/docUploadHeading"
            app:startIconDrawable="@drawable/ic_view_balance"
            app:startIconTint="@color/background">

            <AutoCompleteTextView
                android:id="@+id/docUploadName"
                android:layout_width="match_parent"
                android:layout_height="60sp"
                android:imeOptions="actionDone"
                android:inputType="textCapWords"
                android:maxLength="25"
                android:textColor="@color/background"
                android:textSize="20sp"
                android:textStyle="bold|italic"
                tools:ignore="LabelFor" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/docUpCategoryLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/select_category"
            android:textColorHint="@color/background"
            android:theme="@style/ThemeOverlay.AppTheme.TextInputEditText.Outlined"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/grey"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="2dp"
            app:endIconTint="@color/background"
            app:errorTextColor="@color/red"
            app:hintTextColor="@color/background"
            app:layout_constraintEnd_toEndOf="@+id/docUploadNameLayout"
            app:layout_constraintStart_toStartOf="@+id/docUploadNameLayout"
            app:layout_constraintTop_toBottomOf="@+id/docUploadNameLayout"
            app:startIconDrawable="@drawable/ic_category"
            app:startIconTint="@color/background">

            <AutoCompleteTextView
                android:id="@+id/docUpCategory"
                android:layout_width="match_parent"
                android:layout_height="60sp"
                android:inputType="none"
                android:textColor="@color/background"
                android:textSize="20sp"
                android:textStyle="bold|italic"
                tools:ignore="LabelFor" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/docUploadFileLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/select_document"
            android:textColorHint="@color/background"
            android:theme="@style/ThemeOverlay.AppTheme.TextInputEditText.Outlined"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/grey"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="2dp"
            app:errorTextColor="@color/red"
            app:layout_constraintEnd_toEndOf="@+id/docUpCategoryLayout"
            app:layout_constraintStart_toStartOf="@+id/docUpCategoryLayout"
            app:layout_constraintTop_toBottomOf="@+id/docUpCategoryLayout"
            app:startIconDrawable="@drawable/ic_document"
            app:startIconTint="@color/background">

            <AutoCompleteTextView
                android:id="@+id/docUploadFile"
                android:layout_width="match_parent"
                android:layout_height="60sp"
                android:inputType="none"
                android:textColor="@color/background"
                android:textSize="20sp"
                android:textStyle="bold|italic"
                tools:ignore="LabelFor" />
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/docUploadButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:background="@drawable/button_background"
            android:text="  Submit  "
            android:textColor="@color/white"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/docUploadFileLayout"
            tools:ignore="HardcodedText" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>