<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".General.DashboardActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/white">

            <com.getbase.floatingactionbutton.FloatingActionsMenu
                android:id="@+id/fabBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="20dp"
                app:fab_addButtonColorNormal="@color/background"
                app:fab_expandDirection="up"
                app:fab_labelStyle="@style/LabelStyle"
                app:fab_labelsPosition="left"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.getbase.floatingactionbutton.FloatingActionButton
                    android:id="@+id/addAppBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:fab_colorNormal="@color/background"
                    app:fab_icon="@drawable/ic_app_dec"
                    app:fab_title="@string/upload_latest_app" />

                <com.getbase.floatingactionbutton.FloatingActionButton
                    android:id="@+id/addDocBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:fab_colorNormal="@color/background"
                    app:fab_icon="@drawable/ic_document"
                    app:fab_title="@string/upload_documents" />

                <com.getbase.floatingactionbutton.FloatingActionButton
                    android:id="@+id/addBalBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:fab_colorNormal="@color/background"
                    app:fab_icon="@drawable/ic_account_balance"
                    app:fab_title="@string/add_balance_details" />

                <com.getbase.floatingactionbutton.FloatingActionButton
                    android:id="@+id/addLendBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:fab_colorNormal="@color/background"
                    app:fab_icon="@drawable/ic_lend_dec"
                    app:fab_title="@string/add_lending_details" />

            </com.getbase.floatingactionbutton.FloatingActionsMenu>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:backgroundTint="@color/white"
        android:fitsSystemWindows="true"
        android:theme="@style/NavigationView"
        app:headerLayout="@layout/navdrawer_header"
        app:itemBackground="@drawable/nav_menu_item_background_state_style"
        app:itemIconTint="@color/nav_menu_item_state_color"
        app:itemTextColor="@color/nav_menu_item_state_color"
        app:menu="@menu/navigation_menu">

    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>