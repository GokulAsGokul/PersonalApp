<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".AddLent.AddLentIndiaFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/lendDecHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/add_india_lent_details"
            android:textColor="@color/background"
            android:textSize="25sp"
            android:textStyle="bold|italic"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/lendDecNameLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="32dp"
            android:hint="@string/borrowerName"
            android:textColorHint="@color/background"
            android:theme="@style/ThemeOverlay.AppTheme.TextInputEditText.Outlined"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/grey"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="2dp"
            app:endIconMode="clear_text"
            app:endIconTint="@color/background"
            app:errorTextColor="@color/red"
            app:hintTextColor="@color/background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lendDecHeading"
            app:startIconDrawable="@drawable/ic_name"
            app:startIconTint="@color/background">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/lendDecName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textCapWords"
                android:textColor="@color/background"
                android:textCursorDrawable="@drawable/color_cursor"
                android:textSize="20sp"
                android:textStyle="bold|italic" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/lendDecAmountLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/amount"
            android:textColorHint="@color/background"
            android:theme="@style/ThemeOverlay.AppTheme.TextInputEditText.Outlined"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/grey"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="2dp"
            app:endIconMode="clear_text"
            app:endIconTint="@color/background"
            app:errorTextColor="@color/red"
            app:hintTextColor="@color/background"
            app:layout_constraintEnd_toEndOf="@+id/lendDecNameLayout"
            app:layout_constraintStart_toStartOf="@+id/lendDecNameLayout"
            app:layout_constraintTop_toBottomOf="@+id/lendDecNameLayout"
            app:startIconDrawable="@drawable/ic_rupee"
            app:startIconTint="@color/background">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/lendDecAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:textColor="@color/background"
                android:textCursorDrawable="@drawable/color_cursor"
                android:textSize="20sp"
                android:textStyle="bold|italic" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/lendDecFromLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/sent_from"
            android:textColorHint="@color/background"
            android:theme="@style/ThemeOverlay.AppTheme.TextInputEditText.Outlined"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/grey"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="2dp"
            app:endIconTint="@color/background"
            app:errorTextColor="@color/red"
            app:hintTextColor="@color/background"
            app:layout_constraintEnd_toEndOf="@+id/lendDecAmountLayout"
            app:layout_constraintStart_toStartOf="@+id/lendDecAmountLayout"
            app:layout_constraintTop_toBottomOf="@+id/lendDecAmountLayout"
            app:startIconDrawable="@drawable/ic_view_balance"
            app:startIconTint="@color/background">

            <AutoCompleteTextView
                android:id="@+id/lendDecFrom"
                android:layout_width="match_parent"
                android:layout_height="60sp"
                android:inputType="none"
                android:textColor="@color/background"
                android:textSize="20sp"
                android:textStyle="bold|italic"
                tools:ignore="LabelFor" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/lendDecToLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/sent_to"
            android:textColorHint="@color/background"
            android:theme="@style/ThemeOverlay.AppTheme.TextInputEditText.Outlined"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/background"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="2dp"
            app:endIconTint="@color/background"
            app:errorTextColor="@color/red"
            app:hintTextColor="@color/background"
            app:layout_constraintEnd_toEndOf="@+id/lendDecFromLayout"
            app:layout_constraintStart_toStartOf="@+id/lendDecFromLayout"
            app:layout_constraintTop_toBottomOf="@+id/lendDecFromLayout"
            app:startIconDrawable="@drawable/ic_account_balance"
            app:startIconTint="@color/background">

            <AutoCompleteTextView
                android:id="@+id/lendDecTo"
                android:layout_width="match_parent"
                android:layout_height="60sp"
                android:inputType="none"
                android:textColor="@color/background"
                android:textSize="20sp"
                android:textStyle="bold|italic"
                tools:ignore="LabelFor" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/lendDecTranDateLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/transaction_date"
            android:textColorHint="@color/background"
            android:theme="@style/ThemeOverlay.AppTheme.TextInputEditText.Outlined"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/grey"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="2dp"
            app:errorTextColor="@color/red"
            app:layout_constraintEnd_toEndOf="@+id/lendDecToLayout"
            app:layout_constraintStart_toStartOf="@+id/lendDecToLayout"
            app:layout_constraintTop_toBottomOf="@+id/lendDecToLayout"
            app:startIconDrawable="@drawable/ic_date"
            app:startIconTint="@color/background">

            <AutoCompleteTextView
                android:id="@+id/lendDecTranDate"
                android:layout_width="match_parent"
                android:layout_height="60sp"
                android:inputType="none"
                android:textColor="@color/background"
                android:textCursorDrawable="@drawable/color_cursor"
                android:textSize="20sp"
                android:textStyle="bold|italic"
                tools:ignore="LabelFor" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/lendDecRemarksLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/remarks"
            android:textColorHint="@color/background"
            android:theme="@style/ThemeOverlay.AppTheme.TextInputEditText.Outlined"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/grey"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="2dp"
            app:counterEnabled="true"
            app:counterMaxLength="20"
            app:counterTextColor="@color/background"
            app:endIconMode="clear_text"
            app:endIconTint="@color/background"
            app:errorTextColor="@color/red"
            app:hintTextColor="@color/background"
            app:layout_constraintEnd_toEndOf="@+id/lendDecTranDateLayout"
            app:layout_constraintStart_toStartOf="@+id/lendDecTranDateLayout"
            app:layout_constraintTop_toBottomOf="@+id/lendDecTranDateLayout"
            app:startIconDrawable="@drawable/ic_remarks"
            app:startIconTint="@color/background">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/lendDecRemarks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSend"
                android:inputType="textCapWords"
                android:maxLength="20"
                android:text="@string/mention_if_any"
                android:textColor="@color/background"
                android:textCursorDrawable="@drawable/color_cursor"
                android:textSize="20sp"
                android:textStyle="bold|italic" />
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/lendDecSubmit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="@drawable/button_background"
            android:text="  Submit  "
            android:textColor="@color/white"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lendDecRemarksLayout"
            tools:ignore="HardcodedText" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>