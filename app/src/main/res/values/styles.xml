<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <!-- This code is for changing the color of the bar. -->
        <!-- Type your colour code which you want to set in colorPrimary item -->
        <item name="colorPrimary">@color/background</item>
        <item name="colorPrimaryDark">@color/background</item>
        <item name="colorAccent">@color/background</item>
        <!-- Dropdown Top and Bottom Color. -->
        <item name="colorSurface">@color/background</item>
        <!-- OncreateOptionsMenu Style -->
        <item name="android:itemTextAppearance">@style/OptionsMenuStyle</item>
    </style>

    <!-- Navigation Drawer Text Custom Style -->
    <style name="NavDrawerTextStyle" parent="Base.TextAppearance.AppCompat">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold|italic</item>
    </style>

    <!-- Navigation Drawer Divider Custom Style -->
    <style name="NavigationView" parent="Base.Theme.AppCompat">
        <item name="android:listDivider">@color/background</item>
        <item name="android:textColorPrimary">@color/background</item>
        <item name="android:textColorSecondary">@color/background</item>
        <item name="textAppearanceSubtitle2">@style/NavDrawerTextStyle</item>
    </style>

    <!-- Edit Text Custom Style -->
    <style name="ThemeOverlay.AppTheme.TextInputEditText.Outlined" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="colorControlActivated">@color/background</item>
    </style>

    <!-- Toast Custom Style -->
    <style name="CustomToast">
        <item name="stColorBackground">@color/background</item>
        <item name="stTextColor">@color/white</item>
        <item name="stLength">LONG</item>
        <item name="stRadius">10dp</item>
        <item name="stTextBold">true</item>
    </style>

    <!-- Error Toast Custom Style -->
    <style name="CustomErrorToast">
        <item name="stColorBackground">@color/red</item>
        <item name="stTextColor">@color/white</item>
        <item name="stLength">LONG</item>
        <item name="stRadius">10dp</item>
        <item name="stTextBold">true</item>
    </style>

    <!-- Date Picker Style -->
    <style name="DateDialogTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorAccent">@color/background</item>
    </style>

    <!-- Delete Dialog Style -->
    <style name="AppCompatAlertDialogStyle" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">@color/background</item>
        <item name="android:textColorPrimary">@color/background</item>
        <item name="android:background">@color/white</item>
    </style>

    <!-- OnCreateOptionsMenu Style -->
    <style name="OptionsMenuStyle" parent="@style/TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/background</item>
        <item name="android:textStyle">italic|bold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextInputLayoutStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="boxStrokeColor">#fff</item>
        <item name="boxStrokeWidth">2dp</item>
    </style>

</resources>